FROM rust:1.96-slim-bookworm AS builder

# 使用官方 Debian 源（USTC 镜像在 Docker 内部网络环境下可能不可达）
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/.cargo .cargo/
COPY backend/Cargo.toml ./

RUN mkdir -p src/bin && \
    echo "fn main() {}" > src/bin/main.rs && \
    echo "" > src/lib.rs && \
    cargo build --release 2>&1 || true && \
    rm -rf src

COPY backend/src ./src
COPY backend/migrations ./migrations

RUN touch src/bin/main.rs src/lib.rs && \
    cargo build --release && \
    mv target/release/moneyrobert /app/moneyrobert

FROM debian:bookworm-slim

WORKDIR /app

RUN unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy && \
    apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/moneyrobert /app/moneyrobert
COPY --from=builder /app/migrations /app/migrations

RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/api/v1/health || exit 1

ENTRYPOINT ["/app/moneyrobert"]
